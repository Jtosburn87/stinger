+// Stinger (Samsung DeX): real pointer shapes for a mouse - android.view.PointerIcon on the window's view,
+// a system shape for JUCE's standard cursors and a bitmap for drawn ones
 class MouseCursor::PlatformSpecificHandle
 {
 public:
-    PlatformSpecificHandle (const MouseCursor::StandardCursorType)      {}
-    PlatformSpecificHandle (const detail::CustomMouseCursorInfo&)       {}
+    PlatformSpecificHandle (const MouseCursor::StandardCursorType type)    : systemType (systemTypeFor (type)) {}
+    PlatformSpecificHandle (const detail::CustomMouseCursorInfo& info)     : custom (info) {}
+
+    static void showInWindow (PlatformSpecificHandle* handle, ComponentPeer* peer)
+    {
+        if (peer == nullptr || peer->getNativeHandle() == nullptr)
+            return;
+
+        auto* env = getEnv();
+        auto view = (jobject) peer->getNativeHandle();
+        LocalRef<jobject> icon (handle != nullptr ? handle->createIcon (env, view) : systemIcon (env, view, typeArrow));
+
+        if (icon == nullptr)
+            return;
+
+        LocalRef<jclass> viewClass (env->FindClass ("android/view/View"));
+        static const jmethodID setPointerIcon = env->GetMethodID (viewClass, "setPointerIcon", "(Landroid/view/PointerIcon;)V");
+        env->CallVoidMethod (view, setPointerIcon, icon.get());
+    }
+
+private:
+    static constexpr int typeNull = 0, typeArrow = 1000;
+
+    static int systemTypeFor (MouseCursor::StandardCursorType type)
+    {
+        switch (type)
+        {
+            case MouseCursor::NoCursor:                      return typeNull;
+            case MouseCursor::WaitCursor:                    return 1004;
+            case MouseCursor::IBeamCursor:                   return 1008;
+            case MouseCursor::CrosshairCursor:               return 1007;
+            case MouseCursor::CopyingCursor:                 return 1011;
+            case MouseCursor::PointingHandCursor:            return 1002;
+            case MouseCursor::DraggingHandCursor:            return 1021;
+            case MouseCursor::LeftRightResizeCursor:
+            case MouseCursor::LeftEdgeResizeCursor:
+            case MouseCursor::RightEdgeResizeCursor:         return 1014;
+            case MouseCursor::UpDownResizeCursor:
+            case MouseCursor::TopEdgeResizeCursor:
+            case MouseCursor::BottomEdgeResizeCursor:        return 1015;
+            case MouseCursor::UpDownLeftRightResizeCursor:   return 1013;
+            case MouseCursor::TopLeftCornerResizeCursor:
+            case MouseCursor::BottomRightCornerResizeCursor: return 1017;
+            case MouseCursor::TopRightCornerResizeCursor:
+            case MouseCursor::BottomLeftCornerResizeCursor:  return 1016;
+            case MouseCursor::ParentCursor:
+            case MouseCursor::NormalCursor:
+            case MouseCursor::NumStandardCursorTypes:
+            default:                                         return typeArrow;
+        }
+    }
+
+    static jobject systemIcon (JNIEnv* env, jobject view, int type)
+    {
+        LocalRef<jclass> viewClass (env->FindClass ("android/view/View"));
+        LocalRef<jclass> iconClass (env->FindClass ("android/view/PointerIcon"));
+        static const jmethodID getContext = env->GetMethodID (viewClass, "getContext", "()Landroid/content/Context;");
+        static const jmethodID getSystemIcon = env->GetStaticMethodID (iconClass, "getSystemIcon",
+                                                                        "(Landroid/content/Context;I)Landroid/view/PointerIcon;");
+        LocalRef<jobject> context (env->CallObjectMethod (view, getContext));
+        return env->CallStaticObjectMethod (iconClass, getSystemIcon, context.get(), (jint) type);
+    }
+
+    jobject createIcon (JNIEnv* env, jobject view)
+    {
+        if (systemType >= 0)
+            return systemIcon (env, view, systemType);
+
+        if (customIcon == nullptr)
+        {
+            // drawn at the screen's density, hotspot scaled with it (as JUCE does on Windows)
+            const auto logical = custom.image.getScaledBounds();
+            const auto density = (float) Desktop::getInstance().getDisplays().getPrimaryDisplay()->scale;
+            const auto width = jmax (1, roundToInt ((float) logical.getWidth() * density));
+            const auto height = jmax (1, roundToInt ((float) logical.getHeight() * density));
+            const auto image = custom.image.getImage().rescaled (width, height).convertedToFormat (Image::ARGB);
+            const auto effectiveScale = (float) width / (float) jmax (1.0, logical.getWidth());
+
+            LocalRef<jintArray> pixels (env->NewIntArray (width * height));
+            {
+                std::vector<jint> argb ((size_t) (width * height));
+                for (int y = 0; y < height; ++y)
+                    for (int x = 0; x < width; ++x)
+                        argb[(size_t) (y * width + x)] = (jint) image.getPixelAt (x, y).getARGB();
+                env->SetIntArrayRegion (pixels.get(), 0, width * height, argb.data());
+            }
+
+            LocalRef<jclass> bitmapClass (env->FindClass ("android/graphics/Bitmap"));
+            LocalRef<jclass> configClass (env->FindClass ("android/graphics/Bitmap$Config"));
+            LocalRef<jclass> iconClass (env->FindClass ("android/view/PointerIcon"));
+            static const jmethodID createBitmap = env->GetStaticMethodID (bitmapClass, "createBitmap",
+                                                                          "([IIILandroid/graphics/Bitmap$Config;)Landroid/graphics/Bitmap;");
+            static const jfieldID argb8888 = env->GetStaticFieldID (configClass, "ARGB_8888", "Landroid/graphics/Bitmap$Config;");
+            static const jmethodID create = env->GetStaticMethodID (iconClass, "create", "(Landroid/graphics/Bitmap;FF)Landroid/view/PointerIcon;");
+
+            LocalRef<jobject> config (env->GetStaticObjectField (configClass, argb8888));
+            LocalRef<jobject> bitmap (env->CallStaticObjectMethod (bitmapClass, createBitmap, pixels.get(), (jint) width, (jint) height, config.get()));
+            const auto hx = (jfloat) jlimit (0, width - 1,  roundToInt ((float) custom.hotspot.x * effectiveScale));
+            const auto hy = (jfloat) jlimit (0, height - 1, roundToInt ((float) custom.hotspot.y * effectiveScale));
+            customIcon = GlobalRef (LocalRef<jobject> (env->CallStaticObjectMethod (iconClass, create, bitmap.get(), hx, hy)));
+        }
+
+        return customIcon == nullptr ? nullptr : env->NewLocalRef (customIcon.get());
+    }
 
-    static void showInWindow (PlatformSpecificHandle*, ComponentPeer*)  {}
+    int systemType = -1;
+    detail::CustomMouseCursorInfo custom;
+    GlobalRef customIcon;
 };
 
