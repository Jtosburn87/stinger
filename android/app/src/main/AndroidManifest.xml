<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Recording into a button: the phone's microphone or a USB audio interface. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Pull WAV / Import links, and the Wi-Fi remote. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.audio.low_latency" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name="com.rmsl.juce.JuceApp"
        android:label="Stinger"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name="com.leftnoiseaudio.stinger.StingerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The phone's own screen while Stinger is on the DeX desktop: its own task, so both stay open. -->
        <activity
            android:name="com.leftnoiseaudio.stinger.DeckActivity"
            android:exported="false"
            android:label="Stinger Deck"
            android:taskAffinity="com.leftnoiseaudio.stinger.deck"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:hardwareAccelerated="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density" />

        <!-- Samsung DeX: don't restart Stinger (and stop a playing show) when it moves between the phone and the monitor. -->
        <meta-data android:name="com.samsung.android.keepalive.density" android:value="true" />
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="true" />
    </application>
</manifest>
